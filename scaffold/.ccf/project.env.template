# Claude Code Framework — Project Configuration
# Generated by setup.sh — DO NOT COMMIT (in .gitignore)
# Edit values then re-run: bash "$CCF_FRAMEWORK_DIR/setup.sh" (or edit directly)

# ── Identity ───────────────────────────────────────────────────────────────────
CCF_PROJECT_NAME="my-project"
CCF_PROJECT_CATEGORY="app"          # app|library|cli|idea — gates which loop steps run:
                                    #   app:     health curl + tests + deploy
                                    #   library: tests, no live URL / deploy
                                    #   cli:     tests, no live URL / deploy
                                    #   idea:    no code gates — doc checks + review gate only
CCF_PROJECT_TYPE="python-fastapi"   # python-fastapi|python-django|node-express|go|react-spa|cli|idea
CCF_PROJECT_DIR="/path/to/project"
CCF_NORTH_STAR="What this project does in one sentence"

# ── Runtime ────────────────────────────────────────────────────────────────────
CCF_LIVE_URL="https://your-app.example.com"          # blank = skip health/live-E2E checks
CCF_HEALTH_PATH="/health"                             # path appended to CCF_LIVE_URL
CCF_TEST_CMD="python3 -m pytest tests/ -q --tb=short" # blank = review gate instead of test gate

# ── CI / Deployment ────────────────────────────────────────────────────────────
CCF_GITHUB_REPO="user/repo"                           # blank = no CI checks
CCF_DEPLOY_TARGET="railway"                           # railway|vercel|fly|aws|local
CCF_DEPLOY_CMD="railway up --detach"                  # blank = commit only, never deploy

# ── Framework ──────────────────────────────────────────────────────────────────
CCF_FRAMEWORK_DIR="$HOME/Claude Code Framework"

# ── API Keys ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."                        # for /qa computer-use + AI features
# SENTRY_DSN=""                                       # optional: error tracking
# GITHUB_TOKEN=""                                     # if gh CLI auth not sufficient
